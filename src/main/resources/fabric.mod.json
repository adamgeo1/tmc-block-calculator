{
    "schemaVersion": 1,
    "id": "trappedmc-block-calculator",
    "version": "${version}",
    "name": "TrappedMC Block Calculator",
    "description": "Provides calculated prices for inventories of sellable items on TrappedMC",
    "authors": [
        "adamgeo"
    ],
    "contact": {
        "homepage": "https://fabricmc.net/",
        "sources": "https://github.com/FabricMC/fabric-example-mod"
    },
    "license": "CC0-1.0",
    "icon": "assets/trappedmc-block-calculator/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "tmc.block_calculator.TrappedMCBlockCalculator"
        ],
        "client": [
            "tmc.block_calculator.client.TrappedMCBlockCalculatorClient"
        ]
    },
    "mixins": [
        "trappedmc-block-calculator.mixins.json",
        {
            "config": "trappedmc-block-calculator.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.19.5",
        "minecraft": "~26.1.2",
        "java": ">=25",
        "fabric-api": "*"
    }
}
